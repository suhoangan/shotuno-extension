# API (NestJS) — used by fetch calls and host_permissions
VITE_API_URL=http://localhost:3000

# Marketing site — used for login/pricing links and externally_connectable
VITE_WEB_URL=http://localhost:3001

# Google OAuth client ID for chrome.identity (required for production builds)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Local only: unlock all Pro tools without login or credits
# true | false — never leave true in production builds
VITE_UNLOCK_PRO_FEATURES=false
